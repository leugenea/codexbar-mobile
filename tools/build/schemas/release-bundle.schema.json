{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "signedInspection"
              ]
            },
            {
              "required": [
                "acceptedUnsigned"
              ]
            }
          ]
        }
      },
      "if": {
        "properties": {
          "stage": {
            "const": "final-signed"
          }
        }
      },
      "then": {
        "required": [
          "signedInspection",
          "acceptedUnsigned"
        ]
      }
    }
  ],
  "properties": {
    "acceptedUnsigned": {
      "additionalProperties": false,
      "properties": {
        "apk": {
          "additionalProperties": false,
          "properties": {
            "filename": {
              "pattern": "^[A-Za-z0-9_.+-]+\\.apk$",
              "type": "string"
            },
            "sha256": {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            "size": {
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "filename",
            "size",
            "sha256"
          ],
          "type": "object"
        },
        "bundleManifestSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "apk",
        "bundleManifestSha256"
      ],
      "type": "object"
    },
    "apk": {
      "additionalProperties": false,
      "properties": {
        "filename": {
          "pattern": "^[A-Za-z0-9_.+-]+\\.apk$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "size": {
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "filename",
        "size",
        "sha256"
      ],
      "type": "object"
    },
    "attributionStatus": {
      "const": "bounded-source-backed"
    },
    "boundary": {
      "minLength": 1,
      "type": "string"
    },
    "buildInputs": {
      "additionalProperties": false,
      "properties": {
        "channel": {
          "enum": [
            "dev",
            "rc",
            "stable"
          ]
        },
        "debugPackage": {
          "const": "io.github.leugenea.codexbarmobile.dev"
        },
        "releasePackage": {
          "const": "io.github.leugenea.codexbarmobile"
        },
        "source": {
          "additionalProperties": false,
          "properties": {
            "sha": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            },
            "tree": {
              "pattern": "^[0-9a-f]{40}$",
              "type": "string"
            }
          },
          "required": [
            "sha",
            "tree"
          ],
          "type": "object"
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
          "type": "string"
        },
        "versionCode": {
          "maximum": 2100000000,
          "minimum": 1,
          "type": "integer"
        },
        "versionName": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "source",
        "target",
        "channel",
        "tag",
        "versionName",
        "versionCode",
        "debugPackage",
        "releasePackage"
      ],
      "type": "object"
    },
    "distributionApproval": {
      "const": false
    },
    "files": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "path": {
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?/)(?!.*\\\\)(?!.*//)[A-Za-z0-9_.!/-]+$",
            "type": "string"
          },
          "sha256": {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
          },
          "size": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "path",
          "size",
          "sha256"
        ],
        "type": "object"
      },
      "minItems": 5,
      "type": "array",
      "uniqueItems": true
    },
    "kind": {
      "const": "release-runtime-bundle"
    },
    "schema": {
      "const": 1
    },
    "signedInspection": {
      "properties": {
        "signerCertificateSha256": {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        "unsigned": {
          "const": false
        }
      },
      "required": [
        "unsigned",
        "signerCertificateSha256"
      ],
      "type": "object"
    },
    "stage": {
      "enum": [
        "unsigned",
        "final-signed"
      ]
    }
  },
  "required": [
    "schema",
    "kind",
    "stage",
    "buildInputs",
    "apk",
    "attributionStatus",
    "distributionApproval",
    "boundary",
    "files"
  ],
  "type": "object"
}
