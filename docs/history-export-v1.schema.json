{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CodexBar Mobile usage-history export v1",
  "type": "object",
  "required": [
    "formatVersion",
    "appVersion",
    "exportedAt",
    "entries",
    "continuation"
  ],
  "properties": {
    "formatVersion": {
      "const": 1,
      "type": "integer"
    },
    "appVersion": {
      "type": "string"
    },
    "exportedAt": {
      "type": "string",
      "description": "java.time.Instant ISO-8601 string, nanosecond precision (not a local time)."
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      },
      "maxItems": 100000
    },
    "continuation": {
      "$ref": "#/$defs/continuation"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "Knowledge": {
      "type": "string",
      "enum": [
        "KNOWN",
        "UNAVAILABLE",
        "MALFORMED",
        "UNSUPPORTED"
      ]
    },
    "Reason": {
      "type": "string",
      "enum": [
        "MISSING",
        "PROVIDER_NULL",
        "WRONG_TYPE",
        "OUT_OF_RANGE",
        "UNSUPPORTED_FORMAT",
        "CLOCK_REQUIRED"
      ]
    },
    "Slot": {
      "type": "string",
      "enum": [
        "PRIMARY",
        "SECONDARY"
      ]
    },
    "WindowKind": {
      "type": "string",
      "enum": [
        "FIVE_HOUR",
        "WEEKLY",
        "UNSUPPORTED",
        "UNKNOWN"
      ]
    },
    "SelectionState": {
      "type": "string",
      "enum": [
        "KNOWN",
        "UNAVAILABLE",
        "MALFORMED",
        "AMBIGUOUS"
      ]
    },
    "BreakReason": {
      "type": "string",
      "enum": [
        "FIRST_OBSERVATION",
        "WINDOW_CHANGED",
        "PERCENT_CORRECTION",
        "BACKGROUND",
        "READ_ERROR",
        "FIELD_GAP",
        "AMBIGUOUS_WINDOW",
        "UNKEYED_RESET",
        "UNKNOWN_OBSERVATION_TIME",
        "INTERVAL_EXCEEDED",
        "NON_INCREASING_WALL_TIME",
        "MONOTONIC_UNAVAILABLE",
        "NON_INCREASING_MONOTONIC_TIME",
        "WALL_MONOTONIC_DIVERGENCE",
        "NEW_CLOCK_EPOCH"
      ]
    },
    "ResetProvenance": {
      "type": "string",
      "enum": [
        "ABSOLUTE",
        "RELATIVE_DERIVED",
        "UNKNOWN",
        "AMBIGUOUS",
        "MALFORMED",
        "UNSUPPORTED",
        "DISCREPANT"
      ]
    },
    "NominalStartConfidence": {
      "type": "string",
      "enum": [
        "NOMINAL_FULL_QUOTA",
        "UNCERTAIN_CORRECTION",
        "UNAVAILABLE"
      ]
    },
    "BaselineEligibility": {
      "type": "string",
      "enum": [
        "ELIGIBLE",
        "UNKNOWN_OBSERVATION_TIME",
        "WINDOW_UNAVAILABLE",
        "AMBIGUOUS_WINDOW",
        "UNKNOWN_PERCENT",
        "UNKEYED_RESET",
        "BEFORE_NOMINAL_START",
        "AFTER_RESET",
        "CLOCK_UNVERIFIED",
        "CLOCK_DISCONTINUITY",
        "UNCERTAIN_CORRECTION",
        "TIME_RANGE_OVERFLOW"
      ]
    },
    "HistoryGap": {
      "type": "string",
      "enum": [
        "BACKGROUND",
        "READ_ERROR"
      ]
    },
    "clock": {
      "type": "object",
      "required": [
        "epoch",
        "monotonicMillis"
      ],
      "properties": {
        "epoch": {
          "type": "string",
          "format": "uuid"
        },
        "monotonicMillis": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "longField": {
      "type": "object",
      "required": [
        "knowledge",
        "reason",
        "value"
      ],
      "properties": {
        "knowledge": {
          "$ref": "#/$defs/Knowledge"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": -9223372036854775808,
              "maximum": 9223372036854775807
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "percentField": {
      "type": "object",
      "required": [
        "knowledge",
        "reason",
        "value"
      ],
      "properties": {
        "knowledge": {
          "$ref": "#/$defs/Knowledge"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256,
              "description": "Exact BigDecimal.toString(); preserves scale and exponent, never a floating-point approximation."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "instantField": {
      "type": "object",
      "required": [
        "knowledge",
        "reason",
        "value"
      ],
      "properties": {
        "knowledge": {
          "$ref": "#/$defs/Knowledge"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "description": "java.time.Instant ISO-8601 string, nanosecond precision (not a local time)."
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "booleanField": {
      "type": "object",
      "required": [
        "knowledge",
        "reason",
        "value"
      ],
      "properties": {
        "knowledge": {
          "$ref": "#/$defs/Knowledge"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "required": [
        "kind",
        "durationSeconds",
        "resetAt"
      ],
      "properties": {
        "kind": {
          "enum": [
            "FIVE_HOUR",
            "WEEKLY"
          ]
        },
        "durationSeconds": {
          "enum": [
            18000,
            604800
          ]
        },
        "resetAt": {
          "type": "string",
          "description": "java.time.Instant ISO-8601 string, nanosecond precision (not a local time)."
        }
      },
      "additionalProperties": true
    },
    "segment": {
      "type": "object",
      "required": [
        "kind",
        "firstOrdinal",
        "window",
        "breaks",
        "resetCause"
      ],
      "properties": {
        "kind": {
          "enum": [
            "FIVE_HOUR",
            "WEEKLY"
          ]
        },
        "firstOrdinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "window": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "breaks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BreakReason"
          },
          "uniqueItems": true
        },
        "resetCause": {
          "const": "UNKNOWN"
        }
      },
      "additionalProperties": true
    },
    "point": {
      "type": "object",
      "required": [
        "ordinal",
        "observedAt",
        "clock",
        "usedPercent",
        "segment",
        "nominalStart",
        "baseline"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "observedAt": {
          "type": "string",
          "description": "java.time.Instant ISO-8601 string, nanosecond precision (not a local time)."
        },
        "clock": {
          "$ref": "#/$defs/clock"
        },
        "usedPercent": {
          "type": "string"
        },
        "segment": {
          "$ref": "#/$defs/segment"
        },
        "nominalStart": {
          "$ref": "#/$defs/NominalStartConfidence"
        },
        "baseline": {
          "$ref": "#/$defs/BaselineEligibility"
        }
      },
      "additionalProperties": true
    },
    "tail": {
      "type": "object",
      "required": [
        "lastPoint",
        "lastCandidate",
        "nominalStart",
        "pendingBreak"
      ],
      "properties": {
        "lastPoint": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastCandidate": {
          "anyOf": [
            {
              "$ref": "#/$defs/identity"
            },
            {
              "type": "null"
            }
          ]
        },
        "nominalStart": {
          "$ref": "#/$defs/NominalStartConfidence"
        },
        "pendingBreak": {
          "anyOf": [
            {
              "$ref": "#/$defs/BreakReason"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "reset": {
      "type": "object",
      "required": [
        "provenance",
        "facts"
      ],
      "properties": {
        "provenance": {
          "$ref": "#/$defs/ResetProvenance"
        },
        "facts": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "absolute",
                "relativeSeconds",
                "relativeDerived",
                "discrepant",
                "due"
              ],
              "properties": {
                "absolute": {
                  "$ref": "#/$defs/instantField"
                },
                "relativeSeconds": {
                  "$ref": "#/$defs/longField"
                },
                "relativeDerived": {
                  "$ref": "#/$defs/instantField"
                },
                "discrepant": {
                  "type": "boolean"
                },
                "due": {
                  "anyOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "window": {
      "type": "object",
      "required": [
        "kind",
        "selection",
        "duration",
        "percent",
        "reset",
        "point",
        "baseline"
      ],
      "properties": {
        "kind": {
          "enum": [
            "FIVE_HOUR",
            "WEEKLY"
          ]
        },
        "selection": {
          "$ref": "#/$defs/SelectionState"
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/longField"
            },
            {
              "type": "null"
            }
          ]
        },
        "percent": {
          "anyOf": [
            {
              "$ref": "#/$defs/percentField"
            },
            {
              "type": "null"
            }
          ]
        },
        "reset": {
          "$ref": "#/$defs/reset"
        },
        "point": {
          "anyOf": [
            {
              "$ref": "#/$defs/point"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline": {
          "$ref": "#/$defs/BaselineEligibility"
        }
      },
      "additionalProperties": true
    },
    "slot": {
      "type": "object",
      "required": [
        "slot",
        "knowledge",
        "reason",
        "kind",
        "duration"
      ],
      "properties": {
        "slot": {
          "$ref": "#/$defs/Slot"
        },
        "knowledge": {
          "$ref": "#/$defs/Knowledge"
        },
        "reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/Reason"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/WindowKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/longField"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "entry": {
      "type": "object",
      "required": [
        "ordinal",
        "clock",
        "observedAt",
        "gap",
        "windows",
        "slots",
        "allowed",
        "limitReached"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9223372036854775807
        },
        "clock": {
          "$ref": "#/$defs/clock"
        },
        "observedAt": {
          "anyOf": [
            {
              "type": "string",
              "description": "java.time.Instant ISO-8601 string, nanosecond precision (not a local time)."
            },
            {
              "type": "null"
            }
          ]
        },
        "gap": {
          "anyOf": [
            {
              "$ref": "#/$defs/HistoryGap"
            },
            {
              "type": "null"
            }
          ]
        },
        "windows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/window"
          },
          "maxItems": 2
        },
        "slots": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/slot"
          },
          "maxItems": 2
        },
        "allowed": {
          "anyOf": [
            {
              "$ref": "#/$defs/booleanField"
            },
            {
              "type": "null"
            }
          ]
        },
        "limitReached": {
          "anyOf": [
            {
              "$ref": "#/$defs/booleanField"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "continuation": {
      "type": "object",
      "required": [
        "highWaterOrdinal",
        "cursor",
        "ageAnchor",
        "ageSuspended",
        "cutoffs",
        "lastClock"
      ],
      "properties": {
        "highWaterOrdinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9223372036854775807
        },
        "cursor": {
          "type": "object",
          "required": [
            "fiveHour",
            "weekly"
          ],
          "properties": {
            "fiveHour": {
              "$ref": "#/$defs/tail"
            },
            "weekly": {
              "$ref": "#/$defs/tail"
            }
          },
          "additionalProperties": true
        },
        "ageAnchor": {
          "anyOf": [
            {
              "type": "object",
              "required": [
                "at",
                "clock"
              ],
              "properties": {
                "at": {
                  "type": "string",
                  "description": "java.time.Instant ISO-8601 string, nanosecond precision (not a local time)."
                },
                "clock": {
                  "$ref": "#/$defs/clock"
                }
              },
              "additionalProperties": true
            },
            {
              "type": "null"
            }
          ]
        },
        "ageSuspended": {
          "type": "boolean"
        },
        "cutoffs": {
          "type": "object",
          "properties": {
            "AGE_RETENTION": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "OBSERVATION_CAP": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            },
            "BYTE_CAP": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9223372036854775807
            }
          },
          "additionalProperties": true
        },
        "lastClock": {
          "anyOf": [
            {
              "$ref": "#/$defs/clock"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": true
    }
  }
}
