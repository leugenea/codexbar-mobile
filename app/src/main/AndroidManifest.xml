<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only selected authenticated routes use the network; cleartext stays disabled. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:usesCleartextTraffic="false"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CodexBarMobile">
        <meta-data android:name="io.github.leugenea.codexbarmobile.SOURCE_REVISION" android:value="${sourceRevision}" />
        <meta-data android:name="io.github.leugenea.codexbarmobile.SOURCE_TREE" android:value="${sourceTree}" />
        <meta-data android:name="io.github.leugenea.codexbarmobile.BUILD_CHANNEL" android:value="${buildChannel}" />
        <activity android:name="io.github.leugenea.codexbarmobile.MainActivity" android:exported="true" android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
